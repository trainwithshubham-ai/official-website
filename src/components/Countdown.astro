---
// Countdown — the only timer island (ARCHITECTURE.md §5). Counts to ONE real deadline
// passed by the caller: today that is the sale's end (`variant="marker"`, invisible) and
// a future live course's start (CourseLanding). There is no default deadline: the
// flagship is self-paced, so no timer renders unless a real deadline is supplied.
//
// Honest scarcity: on expiry it does NOT reset or vanish. It flips to a calm ended
// state via [data-expired] (CSS swap, no layout shift, works even if JS is slow).
//
// The `marker` variant renders nothing: a container keys CSS off a deadline it doesn't
// visibly display (e.g. the sale claim hiding itself when the sale ends).

interface Props {
  variant?: "full" | "chip" | "marker";
  /** The real deadline (ISO 8601). Required. */
  deadline: string;
  /** Eyebrow above the digits in the "full" variant. */
  label?: string;
  /** Copy shown once the deadline passes (the calm, honest flip, never a reset). */
  endedText?: string;
  /** Expose the deadline to screen readers. Set on exactly ONE mount per page
   *  so the same deadline isn't announced multiple times. */
  announceDeadline?: boolean;
  /** SR sentence wrapping the deadline; "{date}" is replaced with it. */
  srLabel?: string;
  class?: string;
}
const {
  variant = "full",
  deadline,
  label = "starts in",
  endedText = "enrolment open",
  announceDeadline = false,
  srLabel = "Deadline: {date} IST.",
  class: className = "",
} = Astro.props;

// Static, screen-reader-friendly deadline (the ticking digits are aria-hidden).
const deadlineLabel = new Date(deadline).toLocaleString("en-IN", {
  day: "numeric",
  month: "long",
  year: "numeric",
  hour: "2-digit",
  minute: "2-digit",
  timeZone: "Asia/Kolkata",
});

// Resolve expiry at BUILD time for a deadline that has already passed, so the first
// paint never flashes "-- days -- hrs" before the script flips it.
const expiredAtBuild = new Date(deadline).getTime() < Date.now();

const units = [
  { key: "d", label: "days" },
  { key: "h", label: "hrs" },
  { key: "m", label: "min" },
  { key: "s", label: "sec" },
];
---

<div
  class:list={["countdown", `countdown--${variant}`, className]}
  data-countdown
  data-deadline={deadline}
  data-expired={expiredAtBuild ? "true" : "false"}
  hidden={variant === "marker"}
  aria-hidden={variant === "marker" ? "true" : undefined}
>
  {
    variant === "marker" ? null : (
      <Fragment>
        {/* live ticker (visual only) */}
        <div class="cd-live" aria-hidden="true">
          {variant === "full" && (
            <p class="font-mono text-[length:var(--text-eyebrow)] lowercase tracking-[0.08em] text-signal">
              ❯ {label}
            </p>
          )}
          <div class="cd-units">
            {units.map((u) => (
              <span class="cd-unit">
                <span class="cd-num font-mono" data-unit={u.key}>
                  --
                </span>
                <span class="cd-lbl font-mono">{u.label}</span>
              </span>
            ))}
          </div>
        </div>

        {/* expired state (revealed by CSS when [data-expired="true"]) */}
        <p class="cd-ended font-mono text-[length:var(--text-eyebrow)] text-muted">
          <span class="text-signal" aria-hidden="true">
            ●
          </span>{" "}
          {endedText}
        </p>

        {/* Accessible deadline — exposed on exactly ONE mount (announceDeadline)
            so screen readers don't hear the same deadline repeated. */}
        {announceDeadline && (
          <span class="sr-only">
            {srLabel.replace("{date}", `${deadlineLabel}`)}
          </span>
        )}
      </Fragment>
    )
  }
</div>

<style>
  .countdown {
    display: inline-flex;
    flex-direction: column;
    gap: 0.5rem;
  }
  /* The marker is a deadline signal only — it must never occupy space. Needs its own
     rule because .countdown's display:inline-flex would otherwise beat [hidden]. */
  .countdown--marker {
    display: none;
  }
  .cd-units {
    display: flex;
    gap: 0.5rem;
    align-items: stretch;
  }
  .cd-unit {
    display: flex;
    flex-direction: column;
    align-items: center;
    min-width: 3.25rem;
    padding: 0.5rem 0.5rem 0.4rem;
    background: var(--color-surface);
    border: 1px solid var(--color-line);
    border-radius: 10px;
  }
  .cd-num {
    font-size: 1.5rem;
    font-weight: 500;
    color: var(--color-text);
    font-variant-numeric: tabular-nums;
    line-height: 1.1;
  }
  .cd-lbl {
    font-size: 0.625rem;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--color-muted);
  }

  /* compact chip for the nav */
  .countdown--chip .cd-units {
    gap: 0.25rem;
  }
  .countdown--chip .cd-unit {
    flex-direction: row;
    align-items: baseline;
    gap: 0.15rem;
    min-width: 0;
    padding: 0.2rem 0.4rem;
    background: transparent;
    border: 0;
  }
  .countdown--chip .cd-num {
    font-size: 0.95rem;
    color: var(--color-signal);
  }
  .countdown--chip .cd-lbl {
    font-size: 0.6rem;
  }

  /* expiry swap — no layout shift, CSS-driven */
  .cd-ended {
    display: none;
  }
  .countdown[data-expired="true"] .cd-live {
    display: none;
  }
  .countdown[data-expired="true"] .cd-ended {
    display: block;
  }
</style>

<script>
  // Drives every countdown on the page from ONE timer. No framework. Each node counts to
  // its data-deadline, then flips to the calm expired state (never resets).
  const nodes = Array.from(
    document.querySelectorAll<HTMLElement>("[data-countdown]"),
  );
  if (nodes.length) {
    const pad = (n: number) => String(n).padStart(2, "0");
    const states = nodes.map((n) => ({
      n,
      target: new Date(n.dataset.deadline || "").getTime(),
      done: false,
    }));

    const renderNode = (st: (typeof states)[number]) => {
      if (st.done) return;
      const diff = st.target - Date.now();
      if (!(diff > 0)) {
        st.n.dataset.expired = "true";
        st.done = true;
        return;
      }
      const s = Math.floor(diff / 1000);
      const v = {
        d: Math.floor(s / 86400),
        h: Math.floor((s % 86400) / 3600),
        m: Math.floor((s % 3600) / 60),
        s: s % 60,
      };
      for (const k of ["d", "h", "m", "s"] as const) {
        const el = st.n.querySelector<HTMLElement>(`[data-unit="${k}"]`);
        if (el) el.textContent = pad(v[k]);
      }
    };

    states.forEach(renderNode);
    const id = setInterval(() => {
      states.forEach(renderNode);
      if (states.every((st) => st.done)) clearInterval(id);
    }, 1000);
  }
</script>
