---
// Countdown — the ONLY interactive island (ARCHITECTURE.md §5).
// Framed as the deploy window counting down to the batch start (BRAND.md §2, §6).
//
// One component, several mounts (nav / hero / pricing). The <script> below is
// emitted once by Astro no matter how many times the component renders; it drives
// every [data-countdown] instance on the page.
//
// Honest scarcity: on expiry it does NOT reset or vanish — it flips to a calm
// "batch is live · enrolment open" state via [data-expired] (CSS swap, no layout
// shift, works even if JS is slow).
//
// Three modes (one shared script):
//   • fixed  (default) — counts to `deadline`, which defaults to site.batchStartISO
//     (the real cohort start). The sale's expiry marker passes site.sale.endsISO,
//     so one island drives every real deadline with no extra JS.
//   • daily  — counts to TONIGHT'S midnight IST for the repeatable daily bonus,
//     then genuinely rolls to the next day. A real end-of-day deadline, never a
//     fake per-visit 24h reset (golden rule 6 stays intact).
//   • session — counts to the NEXT live class (site.session: Sat/Sun 19:00 IST) and
//     rolls to the following one each weekend. COMPUTED in the browser, never a
//     hardcoded date, so a static site can carry a recurring schedule without a
//     weekly commit — and it can never advertise a session that has already passed.
//
// The `marker` variant renders nothing: it exists purely so a container can key CSS
// off a deadline it doesn't visibly display (e.g. the sale claim hiding itself when
// the sale ends, while the visible timer next to it counts to the next class).
import { site, batchStarted } from "../config/site";

interface Props {
  variant?: "full" | "chip" | "bonus" | "marker";
  /** "daily" rolls to the next IST midnight; "session" to the next class; "fixed"
   *  counts to `deadline`. */
  mode?: "fixed" | "daily" | "session";
  /** What "fixed" counts to. Defaults to the batch start; the sale passes
   *  site.sale.endsISO so one island serves both deadlines. */
  deadline?: string;
  /** Eyebrow above the digits in the "full" variant. */
  label?: string;
  /** Copy shown once the deadline passes (the calm, honest flip — never a reset). */
  endedText?: string;
  /** Expose the deadline to screen readers. Set on exactly ONE mount per page
   *  so the same deadline isn't announced multiple times. */
  announceDeadline?: boolean;
  /** SR sentence wrapping the deadline; "{date}" is replaced with it. */
  srLabel?: string;
  class?: string;
}
const {
  variant = "full",
  mode = "fixed",
  deadline = site.batchStartISO,
  label = "batch starts in",
  endedText = "batch is live · enrolment open",
  announceDeadline = false,
  // Tense-aware DEFAULT, not a per-call-site ternary. Only Hero was fixed by hand
  // originally, which left the stale present tense one `announceDeadline` away from
  // shipping again from any other mount. Callers with their own deadline (a course
  // session) still pass their own srLabel.
  srLabel = batchStarted
    ? "The batch started {date} IST. Enrolment is still open."
    : "The batch starts {date} IST.",
  class: className = "",
} = Astro.props;

// Static, screen-reader-friendly deadline (the ticking digits are aria-hidden).
// For "session" the target is computed client-side, so the SR sentence describes the
// recurring schedule instead of a single instant — always true, never stale.
const deadlineLabel =
  mode === "session"
    ? `${site.classDays}, ${site.classTime}`
    : new Date(deadline).toLocaleString("en-IN", {
        day: "numeric",
        month: "long",
        year: "numeric",
        hour: "2-digit",
        minute: "2-digit",
        timeZone: "Asia/Kolkata",
      });

// Resolve expiry at BUILD time for a fixed deadline that has already passed. Without
// this the markup ships as data-expired="false", so the first paint shows the label plus
// "-- days -- hrs" and only flips to the ended copy once the script runs. On a deadline
// that is weeks past, that is a visible flash of something untrue. Rolling modes (daily,
// session) never expire, so they are always false here and the script drives them.
const expiredAtBuild =
  mode === "fixed" && new Date(deadline).getTime() < Date.now();

const units = [
  { key: "d", label: "days" },
  { key: "h", label: "hrs" },
  { key: "m", label: "min" },
  { key: "s", label: "sec" },
];
---

<div
  class:list={["countdown", `countdown--${variant}`, className]}
  data-countdown
  data-mode={mode}
  data-deadline={mode === "fixed" ? deadline : undefined}
  data-session-days={mode === "session" ? site.session.days.join(",") : undefined}
  data-session-hour={mode === "session" ? String(site.session.hourIST) : undefined}
  data-expired={expiredAtBuild ? "true" : "false"}
  hidden={variant === "marker"}
  aria-hidden={variant === "marker" ? "true" : undefined}
>
  {
    variant === "marker" ? null : variant === "bonus" ? (
      /* slim inline HH:MM:SS for the daily bonus (digits aria-hidden) */
      <span class="cd-bonus font-mono" aria-hidden="true">
        <span data-unit="h">--</span>:<span data-unit="m">--</span>:
        <span data-unit="s">--</span>
      </span>
    ) : (
      <Fragment>
        {/* live ticker (visual only) */}
        <div class="cd-live" aria-hidden="true">
          {variant === "full" && (
            <p class="font-mono text-[length:var(--text-eyebrow)] lowercase tracking-[0.08em] text-signal">
              ❯ {label}
            </p>
          )}
          <div class="cd-units">
            {units.map((u) => (
              <span class="cd-unit">
                <span class="cd-num font-mono" data-unit={u.key}>
                  --
                </span>
                <span class="cd-lbl font-mono">{u.label}</span>
              </span>
            ))}
          </div>
        </div>

        {/* expired state (revealed by CSS when [data-expired="true"]) */}
        <p class="cd-ended font-mono text-[length:var(--text-eyebrow)] text-muted">
          <span class="text-signal" aria-hidden="true">
            ●
          </span>{" "}
          {endedText}
        </p>

        {/* Accessible deadline — exposed on exactly ONE mount (announceDeadline)
            so screen readers don't hear the same deadline repeated. */}
        {announceDeadline && (
          <span class="sr-only">
            {srLabel.replace("{date}", `${deadlineLabel}`)}
          </span>
        )}
      </Fragment>
    )
  }
</div>

<style>
  .countdown {
    display: inline-flex;
    flex-direction: column;
    gap: 0.5rem;
  }
  /* The marker is a deadline signal only — it must never occupy space. Needs its own
     rule because .countdown's display:inline-flex would otherwise beat [hidden]. */
  .countdown--marker {
    display: none;
  }
  .cd-units {
    display: flex;
    gap: 0.5rem;
    align-items: stretch;
  }
  .cd-unit {
    display: flex;
    flex-direction: column;
    align-items: center;
    min-width: 3.25rem;
    padding: 0.5rem 0.5rem 0.4rem;
    background: var(--color-surface);
    border: 1px solid var(--color-line);
    border-radius: 10px;
  }
  .cd-num {
    font-size: 1.5rem;
    font-weight: 500;
    color: var(--color-text);
    font-variant-numeric: tabular-nums;
    line-height: 1.1;
  }
  .cd-lbl {
    font-size: 0.625rem;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--color-muted);
  }

  /* compact chip for the nav */
  .countdown--chip .cd-units {
    gap: 0.25rem;
  }
  .countdown--chip .cd-unit {
    flex-direction: row;
    align-items: baseline;
    gap: 0.15rem;
    min-width: 0;
    padding: 0.2rem 0.4rem;
    background: transparent;
    border: 0;
  }
  .countdown--chip .cd-num {
    font-size: 0.95rem;
    color: var(--color-signal);
  }
  .countdown--chip .cd-lbl {
    font-size: 0.6rem;
  }

  /* slim inline timer for the daily bonus */
  .cd-bonus {
    font-size: 0.95rem;
    font-weight: 500;
    color: var(--color-signal);
    font-variant-numeric: tabular-nums;
    letter-spacing: 0.02em;
    white-space: nowrap;
  }

  /* expiry swap — no layout shift, CSS-driven */
  .cd-ended {
    display: none;
  }
  .countdown[data-expired="true"] .cd-live {
    display: none;
  }
  .countdown[data-expired="true"] .cd-ended {
    display: block;
  }
</style>

<script>
  // Drives every countdown on the page from ONE timer. No framework.
  // Per node: mode="fixed" → counts to its data-deadline, then flips to the calm
  // expired state. mode="daily" → next midnight IST, ROLLS to the following day.
  // mode="session" → the next live class (data-session-days / data-session-hour),
  // ROLLS to the following one. Rolling modes never expire. IST is a fixed +5:30
  // offset (no DST), so all of this is plain arithmetic — no timezone library.
  const nodes = Array.from(
    document.querySelectorAll<HTMLElement>("[data-countdown]"),
  );
  if (nodes.length) {
    const pad = (n: number) => String(n).padStart(2, "0");
    const IST = 19_800_000; // +5:30 in ms
    const DAY = 86_400_000;
    const HOUR = 3_600_000;
    const nextISTMidnight = () =>
      (Math.floor((Date.now() + IST) / DAY) + 1) * DAY - IST;

    // Next class start, computed — never a hardcoded date, so the schedule can't go
    // stale and a passed session is never advertised. Works in "IST-shifted" epoch
    // (real + 5:30) so getUTCDay()/day boundaries line up with the IST calendar.
    const nextSession = (n: HTMLElement) => {
      const days = (n.dataset.sessionDays || "6,0").split(",").map(Number);
      const hour = Number(n.dataset.sessionHour || "19");
      const now = Date.now();
      const istMidnight = Math.floor((now + IST) / DAY) * DAY;
      // Scan today + 7 days: any weekly schedule has a hit inside that window.
      for (let i = 0; i <= 7; i++) {
        const day = istMidnight + i * DAY;
        if (!days.includes(new Date(day).getUTCDay())) continue;
        const start = day + hour * HOUR - IST;
        if (start > now) return start;
      }
      return now + DAY; // unreachable with a non-empty schedule; keeps types total
    };

    type St = {
      n: HTMLElement;
      rolls: boolean;
      next: () => number;
      target: number;
      done: boolean;
    };
    const states: St[] = nodes.map((n) => {
      const mode = n.dataset.mode;
      const rolls = mode === "daily" || mode === "session";
      const next =
        mode === "daily"
          ? nextISTMidnight
          : mode === "session"
            ? () => nextSession(n)
            : () => new Date(n.dataset.deadline || "").getTime();
      return { n, rolls, next, target: next(), done: false };
    });

    const renderNode = (st: St) => {
      if (st.done) return;
      let diff = st.target - Date.now();
      if (diff <= 0) {
        if (st.rolls) {
          st.target = st.next(); // roll to the next real occurrence
          diff = st.target - Date.now();
        } else {
          st.n.dataset.expired = "true";
          st.done = true;
          return;
        }
      }
      const s = Math.floor(diff / 1000);
      const v = {
        d: Math.floor(s / 86400),
        h: Math.floor((s % 86400) / 3600),
        m: Math.floor((s % 3600) / 60),
        s: s % 60,
      };
      for (const k of ["d", "h", "m", "s"] as const) {
        const el = st.n.querySelector<HTMLElement>(`[data-unit="${k}"]`);
        if (el) el.textContent = pad(v[k]);
      }
    };

    states.forEach(renderNode);
    const id = setInterval(() => {
      states.forEach(renderNode);
      if (states.every((st) => st.done)) clearInterval(id); // only fixed nodes "finish"
    }, 1000);
  }
</script>
