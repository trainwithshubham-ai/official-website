---
// StructuredData — JSON-LD for the search-first audience. Emits one @graph:
//   • Organization (real Google aggregateRating lives on the DevOps Course only)
//   • Course (+ region Offers priced to match the rendered price)
//   • FAQPage
// Default = the main DevOps course (from site.ts + faq.json). Pass `course` to emit a
// standalone course page's graph instead (name/price/faq from courses.ts). Nothing is
// fabricated (golden rule 4): a course page carries NO aggregateRating, because the
// 4.9/260 Google reviews are the DevOps business rating, not that course's.
import { site, saleLive, activePrice } from "../config/site";
import { faq } from "../content/data";
import { isDraftCourse, catalog, type Course } from "../config/courses";
import { tools } from "../content/data";

interface Props {
  /** Same description string BaseLayout renders in <meta name="description">. */
  description: string;
  /** When set, emit this course's graph instead of the main DevOps graph. */
  course?: Course;
  /** Catalog/index pages (e.g. /courses): emit ONLY Organization — not the DevOps
   *  Course/Offer/aggregateRating/FAQ graph, which doesn't belong on a catalog URL. */
  collection?: boolean;
}
const { description, course, collection } = Astro.props;

const home = `${site.domain}/`;
const orgId = `${home}#org`;
const toNum = (s: string) => Number(String(s).replace(/[^0-9.]/g, ""));

// One Offer builder for both branches (course page + main DevOps).
const makeOffer = (
  priceCurrency: string,
  price: number,
  url: string,
  validUntil?: string,
) => ({
  "@type": "Offer",
  // Derived, not passed: a zero-price Offer that still declared itself "Paid" would
  // contradict the isAccessibleForFree flag sitting beside it.
  category: price === 0 ? "Free" : "Paid",
  priceCurrency,
  price,
  ...(validUntil ? { priceValidUntil: validUntil } : {}),
  availability: "https://schema.org/InStock",
  url,
});

const personId = `${home}#shubham`;
const websiteId = `${home}#website`;

const organization = {
  "@type": ["Organization", "EducationalOrganization"],
  "@id": orgId,
  name: site.brand,
  url: home,
  logo: `${site.domain}/logo.png`,
  description:
    "TrainWithShubham teaches DevOps, Cloud, Python and AI engineering through hands-on, production-style courses. English edition.",
  inLanguage: "en",
  founder: { "@id": personId },
  contactPoint: {
    "@type": "ContactPoint",
    contactType: "customer support",
    email: site.contactEmail,
    url: site.contact.whatsapp,
    availableLanguage: ["English", "Hindi"],
  },
  // Related properties of the same entity. The Hindi .com site is a sibling, not a
  // duplicate: linking it here lets engines connect the two as one brand.
  sameAs: [
    site.social.youtube.url,
    site.social.linkedin.url,
    site.social.instagram.url,
    site.englishSocial.youtube,
    site.englishSocial.instagram,
    site.altSites.hindi,
    site.github,
  ],
};

// Standalone Person entity so Course.instructor can point at one stable @id. Facts come
// from the Instructor section; nothing here is invented (golden rule 4).
const person = {
  "@type": "Person",
  "@id": personId,
  name: "Shubham Londhe",
  url: home,
  image: `${site.domain}/instructor-shubham.jpg`,
  jobTitle: "Developer Advocate",
  worksFor: { "@type": "Organization", name: "Temporal" },
  founderOf: { "@id": orgId },
  knowsAbout: ["DevOps", "Cloud computing", "Kubernetes", "Python", "Agentic AI"],
  sameAs: [site.social.linkedin.url, site.social.youtube.url, site.social.instagram.url],
};

const website = {
  "@type": "WebSite",
  "@id": websiteId,
  name: site.brand,
  url: home,
  inLanguage: "en",
  publisher: { "@id": orgId },
};

let graph;

if (collection) {
  // Catalog page — brand identity only; no Course/Offer/rating/FAQ (none of it is
  // shown here, and it would duplicate/misattribute the homepage's Course graph).
  graph = [organization, person];
  if (Astro.url.pathname === "/courses/") {
    graph.push({
      "@type": "ItemList",
      name: `Courses by ${site.brand}`,
      itemListElement: catalog.map((c, i) => ({
        "@type": "ListItem",
        position: i + 1,
        name: c.title,
        url: new URL(c.href, site.domain).href,
      })),
    } as never);
  }
} else if (course) {
  // --- Standalone course page ---
  // Advertise the price the page actually renders (the `now` price). No early-bird
  // window means no priceValidUntil — a standing offer with no expiry.
  // Only `now` is read, and `list` is optional on CoursePrice now — annotating it here
  // would make course.price.india unassignable under astro check.
  const pick = (p: { now: string }) => toNum(p.now);
  // Trailing slash to match BaseLayout's canonical (new URL(pathname) → "/python/").
  const url = `${site.domain}/${course.slug}/`;
  graph = [
    organization,
    person,
    {
      "@type": "BreadcrumbList",
      itemListElement: [
        { "@type": "ListItem", position: 1, name: "Home", item: home },
        { "@type": "ListItem", position: 2, name: "Courses", item: `${site.domain}/courses/` },
        { "@type": "ListItem", position: 3, name: course.title, item: url },
      ],
    },
    {
      "@type": "Course",
      name: course.title,
      description,
      url,
      inLanguage: "en",
      provider: { "@id": orgId },
      ...(course.techStack?.length ? { teaches: course.techStack.join(", ") } : {}),
      hasCourseInstance: {
        "@type": "CourseInstance",
        courseMode: "online",
        // Google wants courseMode + courseWorkload on an on-demand instance. A self-paced
        // course has no startDate, so without this it carries neither signal and drops out
        // of Course rich results. Emitted only from a REAL runtime, as an ISO 8601
        // duration ("8" becomes PT8H); a course with no volume.hours omits it.
        // A trailing "+" ("10+") is a floor, so publish the number as the lower bound
        // rather than dropping the property: understating a runtime is safe, and without
        // it /python carries no workload signal at all. Anything else is ignored.
        ...(course.volume?.hours && /^[\d.]+\+?$/.test(course.volume.hours)
          ? { courseWorkload: `PT${course.volume.hours.replace("+", "")}H` }
          : {}),
        ...(course.batchStartISO ? { startDate: course.batchStartISO } : {}),
        instructor: { "@id": personId },
      },
      // A free course says so explicitly. Google reads isAccessibleForFree + a zero
      // Offer for free-course rich results, which is the one search advantage a brand
      // new page with no backlinks actually has.
      //
      // Both are suppressed for a DRAFT course: `InStock` plus an offer URL is a
      // machine-readable promise that a searcher can enrol at that anchor, and on a page
      // whose enrolment link isn't wired that would route rich-result traffic into a
      // dead end. (The page is also noindex, so this is belt and braces.)
      ...(course.free && !isDraftCourse(course) ? { isAccessibleForFree: true } : {}),
      // Offers only when the course is actually enrollable (a coming-soon course has no
      // price and no free enrolment yet — a price-less Offer would be invalid).
      ...(course.free
        ? isDraftCourse(course)
          ? {}
          : { offers: [makeOffer("INR", 0, `${url}#enroll`)] }
        : course.price
          ? {
              offers: [
                makeOffer("INR", pick(course.price.india), `${url}#enroll`),
                makeOffer("USD", pick(course.price.world), `${url}#enroll`),
              ],
            }
          : {}),
    },
    ...(course.faq?.length
      ? [
          {
            "@type": "FAQPage",
            mainEntity: course.faq.map((f) => ({
              "@type": "Question",
              name: f.q,
              acceptedAnswer: { "@type": "Answer", text: f.a },
            })),
          },
        ]
      : []),
  ];
} else {
  // --- Main DevOps course (default) ---
  // Advertise the price the page actually renders (activePrice's `now`). While a
  // sale is live that's the sale price, and priceValidUntil carries its real end
  // date; with no sale it's a standing offer with no expiry.
  const inrPrice = toNum(activePrice.india.now);
  const usdPrice = toNum(activePrice.world.now);
  const validUntil = saleLive ? site.sale.endsISO : undefined;

  const pricingUrl = `${home}#pricing`;
  graph = [
    organization,
    person,
    website,
    {
      "@type": "Course",
      name: site.product,
      description,
      url: home,
      inLanguage: "en",
      educationalLevel: "Beginner",
      teaches: tools.join(", "),
      provider: { "@id": orgId },
      // Real learner rating (4.9 / 260) — on the Course (the reviewed product), not the
      // Organization, so it's rich-result eligible and not a self-serving org rating.
      aggregateRating: {
        "@type": "AggregateRating",
        ratingValue: site.googleRating,
        reviewCount: site.googleReviewCount,
      },
      hasCourseInstance: {
        "@type": "CourseInstance",
        courseMode: "online",
        // Self-paced: no startDate. courseWorkload is the recorded runtime from site.ts
        // ("150+" is a floor, published as the lower bound).
        courseWorkload: `PT${site.videoHours.replace("+", "")}H`,
        instructor: { "@id": personId },
      },
      offers: [
        makeOffer("INR", inrPrice, pricingUrl, validUntil),
        makeOffer("USD", usdPrice, pricingUrl, validUntil),
      ],
    },
    {
      "@type": "FAQPage",
      mainEntity: faq.map((f) => ({
        "@type": "Question",
        name: f.q,
        acceptedAnswer: { "@type": "Answer", text: f.a },
      })),
    },
  ];
}

const jsonLd = { "@context": "https://schema.org", "@graph": graph };
// Escape "<" so a stray "</script>" or "<" in any answer can't break out of the inline
// script; < is valid JSON and parses back identically.
const json = JSON.stringify(jsonLd).replace(/</g, "\\u003c");
---

<script type="application/ld+json" is:inline set:html={json} />
