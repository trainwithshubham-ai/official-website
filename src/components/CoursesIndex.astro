---
// CoursesIndex — the internal course catalog (/courses). A card per landing page
// from `catalog` (courses.ts): the DevOps flagship + every standalone course page,
// so future courses appear automatically. Price-light — price lives on each landing
// page; real enrolment catalog stays on Learnyst (linked below the grid).
// Reads only shared data; near-zero JS (CSS-only hover). --cta yellow stays reserved
// for Enroll/Pay, so "View course" links use the (per-card) accent, not yellow.
import Section from "./primitives/Section.astro";
import CourseCard from "./primitives/CourseCard.astro";
import { catalog } from "../config/courses";
import { site } from "../config/site";
---

<Section eyebrow="courses" title="Learn by building" as="h1">
  <p class="mb-10 max-w-2xl text-pretty text-muted">
    Live cohorts and self-paced courses. Pick the one for where you are and start
    building. Every one is taught the way it's done in production.
  </p>

  <ul class="grid gap-5 sm:grid-cols-2 lg:grid-cols-3" role="list">
    {
      catalog.map((c) => (
        <li>
          <CourseCard
            href={c.href}
            poster={c.poster}
            title={c.title}
            as="h2"
            theme={c.theme}
            ctaLabel={c.comingSoon ? "Preview" : "View course"}
          >
            {/* One Fragment for the whole tag row: Astro keeps only the LAST child
                assigned to a named slot, so three sibling slot="tags" spans meant the
                format label and the Flagship pill were silently dropped. */}
            <Fragment slot="tags">
              <span class="font-mono text-xs uppercase tracking-[0.08em] text-muted">
                {c.meta}
              </span>
              {c.flagship && (
                <span class="rounded-[var(--radius-pill)] border border-line px-2 py-0.5 font-mono text-[0.62rem] uppercase tracking-[0.08em] text-primary">
                  Flagship
                </span>
              )}
              {/* "Free" is the strongest word on a catalog page, so it gets its own
                  marker rather than hiding inside the blurb. Amber --signal, never the
                  yellow --cta, which belongs to Enroll/Pay alone (golden rule 5). */}
              {c.free && (
                <span class="rounded-[var(--radius-pill)] border border-signal/45 px-2 py-0.5 font-mono text-[0.62rem] uppercase tracking-[0.08em] text-signal">
                  Free
                </span>
              )}
              {c.comingSoon && (
                <span class="rounded-[var(--radius-pill)] border border-line px-2 py-0.5 font-mono text-[0.62rem] uppercase tracking-[0.08em] text-primary">
                  Coming soon
                </span>
              )}
            </Fragment>
            <p class="text-pretty text-sm text-muted">{c.blurb}</p>
          </CourseCard>
        </li>
      ))
    }
  </ul>

  <p class="mt-8 text-sm text-muted">
    Looking for the full catalog?{" "}
    <a
      href={site.lms.explore}
      target="_blank"
      rel="noopener noreferrer"
      data-track="all-courses"
      {/* underlined by default, not just on hover: inside a paragraph, colour alone
          is not a sufficient affordance (WCAG 1.4.1 / Lighthouse link-in-text-block) */}
      class="text-primary underline underline-offset-2 transition-colors hover:no-underline"
    >
      Browse the store →
    </a>
  </p>
</Section>
