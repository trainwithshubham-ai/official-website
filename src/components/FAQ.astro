---
// FAQ — native <details>/<summary> accordion, ZERO JS (ARCHITECTURE.md §4.12).
// Data: faq.json (validated via content/data). Plain text answers, rendered here and
// into the FAQPage JSON-LD (StructuredData.astro).
import Section from "./primitives/Section.astro";
import { faq } from "../content/data";

// Plain-text answers may contain a bare URL (e.g. the Hindi site). Render it as a real
// link in the page; JSON-LD and the markdown outputs keep the plain text.
const parts = (a: string) => a.split(/(https?:\/\/\S+)/g);
---

<Section id="faq" eyebrow="faq" title="Questions, answered">
  <ul class="mx-auto flex max-w-3xl flex-col gap-3" role="list">
    {
      faq.map((item) => (
        <li>
          <details class="faq-card">
            <summary>
              <span class="grow text-text">{item.q}</span>
              <svg class="chev" viewBox="0 0 20 20" fill="none" aria-hidden="true">
                <path
                  d="M5 7.5L10 12.5L15 7.5"
                  stroke="currentColor"
                  stroke-width="2"
                  stroke-linecap="round"
                  stroke-linejoin="round"
                />
              </svg>
            </summary>
            <p class="answer text-pretty text-muted">
              {parts(item.a).map((part) =>
                /^https?:\/\//.test(part) ? (
                  <a
                    href={part}
                    data-track="hindi-site-faq"
                    class="text-primary underline underline-offset-2 hover:no-underline"
                  >
                    {part.replace(/^https?:\/\//, "")}
                  </a>
                ) : (
                  part
                ),
              )}
            </p>
          </details>
        </li>
      ))
    }
  </ul>
</Section>

<style>
  .faq-card {
    border: 1px solid var(--color-line);
    border-radius: var(--radius-card);
    background: var(--color-surface);
  }
  summary {
    display: flex;
    align-items: center;
    gap: 1rem;
    padding: 1.1rem 1.25rem;
    cursor: pointer;
    list-style: none;
    font-weight: 500;
  }
  summary::-webkit-details-marker {
    display: none;
  }
  summary:focus-visible {
    outline: 2px solid var(--color-primary);
    outline-offset: -2px;
    border-radius: var(--radius-card);
  }
  .grow {
    flex: 1;
  }
  .chev {
    width: 20px;
    height: 20px;
    flex-shrink: 0;
    color: var(--color-muted);
    transition: transform 0.2s ease;
  }
  .faq-card[open] .chev {
    transform: rotate(180deg);
  }
  .answer {
    margin: 0;
    padding: 0 1.25rem 1.2rem 1.25rem;
  }
</style>
