---
// Nav — sticky, quiet, conversion-forward. Logo + jump links + a compact
// Countdown chip + a ghost Log-in button (out to the Learnyst LMS) + the yellow
// Enroll CTA. JS-free: a persistent translucent backdrop reads as "floating"
// without a scroll listener (interactivity budget = the countdown only).
// Nav row = Courses (a route) + the on-page anchors (md+ only). Right = Log in +
// Enroll. Collapses to logo + Courses + Log in + Enroll at 380px.
import { site, saleLive } from "../config/site";
import Button from "./primitives/Button.astro";
import Countdown from "./Countdown.astro";
import StatusDot from "./primitives/StatusDot.astro";

// Short form for the slim row — "15 Aug". The full "15 August 2026, 23:59 IST" is
// stated in the Pricing card's sale chip, where the purchase decision happens.
const saleEndsShort = new Date(site.sale.endsISO).toLocaleDateString("en-IN", {
  day: "numeric",
  month: "short",
  timeZone: "Asia/Kolkata",
});

const links = [
  { href: "#curriculum", label: "Curriculum" },
  { href: "#pricing", label: "Pricing" },
  { href: "#community", label: "Community" },
  { href: "#reviews", label: "Reviews" },
];
---

<header
  class="sticky top-0 z-50 border-b border-line/70 bg-ink/80 backdrop-blur-xl supports-[backdrop-filter]:bg-ink/65"
>
  <nav
    class="mx-auto flex h-20 max-w-[var(--container-content)] items-center gap-2 px-6 sm:gap-4"
    aria-label="Primary"
  >
    <a
      href="#top"
      class="flex shrink-0 items-center gap-2.5"
      aria-label={`${site.brand} — home`}
    >
      <img
        src="/logo.png"
        alt={site.brand}
        width="56"
        height="56"
        class="size-14 rounded-md"
        loading="eager"
        decoding="async"
        fetchpriority="high"
      />
      <span class="hidden font-display text-lg font-medium sm:inline"
        >{site.brand}</span
      >
    </a>

    <ul class="ml-2 flex items-center gap-4 md:gap-6">
      <!-- The one cross-page ROUTE in this row: the others scroll this page, this
           one navigates. That's also why it survives the md collapse below — with
           the anchors gone on a phone it's the only thing left to navigate with. -->
      <li>
        <a
          href="/courses"
          class="whitespace-nowrap text-sm text-muted transition-colors hover:text-text"
          >Courses</a
        >
      </li>
      {
        links.map((l) => (
          <li class="hidden md:block">
            <a
              href={l.href}
              class="text-sm text-muted transition-colors hover:text-text"
            >
              {l.label}
            </a>
          </li>
        ))
      }
    </ul>

    <!-- gap tightens at 380px: logo + Courses + Log in + Enroll is exactly at the
         width budget there, and without this the two buttons wrap to two lines. -->
    <div class="ml-auto flex items-center gap-2 sm:gap-3">
      <!-- wrap to hide on mobile: the Countdown's scoped display:inline-flex would
           otherwise override a `hidden` utility placed directly on it.
           While a sale is live the slim row below owns urgency, so this bare chip
           (which would just repeat a second deadline) stands down. -->
      {
        !saleLive && (
          <div class="hidden lg:block">
            <Countdown variant="chip" />
          </div>
        )
      }
      <Button
        variant="ghost"
        href={site.lms.signIn}
        class="whitespace-nowrap px-4 py-2 text-sm"
        target="_blank"
        rel="noopener noreferrer"
        data-track="login"
        aria-label="Log in to your account on the student platform"
        >Log in</Button
      >
      <Button href="#pricing" class="whitespace-nowrap px-4 py-2 text-sm"
        >Enroll now</Button
      >
    </div>
  </nav>

  {
    saleLive ? (
      /* Slim sale row — INSIDE the sticky header, at every width, so the offer stays
         pinned instead of scrolling away like a top banner would. It replaces both
         the old above-nav banner and the mobile-only urgency strip with one element.
         Amber --signal (urgency), never yellow — yellow is the Enroll CTA alone. */
      <div class="nav-sale">
        <p class="nav-sale-lead">
          <StatusDot tone="signal" />
          <span class="nav-sale-name font-mono">
            {site.sale.name.toLowerCase()}
          </span>
        </p>
        {/* Both currencies, always — emphasis is never a hide/swap. On expiry this
            claim is dropped (see CSS) while the row keeps its height, so a sticky
            header can never shrink under the reader mid-scroll. */}
        <p class="nav-sale-claim">
          <strong class="nav-sale-off">
            {site.sale.off.india} · {site.sale.off.world}
          </strong>
          <span class="nav-sale-ends"> · ends {saleEndsShort}</span>
        </p>
        {/* Invisible: the sale's real deadline, so the claim above can drop itself
            when the sale ends. The visible timer beside it counts to the next class,
            which never expires and so can't carry that signal. */}
        <Countdown variant="marker" deadline={site.sale.endsISO} />
        {/* Labelled, or a bare row of digits next to a sale would read as the sale's
            own deadline. Must be a <div>, not a <p>: Countdown's root is a <div>, and
            the parser auto-closes <p> before it — which silently split the label and
            the digits onto two flex lines. */}
        <div class="nav-sale-next">
          <span class="nav-sale-next-lbl font-mono">❯ next session in</span>
          <Countdown variant="chip" mode="session" class="nav-sale-cd" />
        </div>
      </div>
    ) : (
      /* No sale: the desktop chip is hidden below lg, so phone users would otherwise
         feel no urgency until Pricing. Carries the same next-class timer, which is
         always true and never expires — unlike the old batch countdown, which went
         permanently stale the day the cohort started. */
      <div class="nav-urgency flex items-center justify-center gap-2 border-t border-line/60 px-4 py-1.5 lg:hidden">
        <span class="nav-urgency-lbl font-mono text-[0.7rem] lowercase tracking-[0.06em] text-muted">
          ❯ next session in
        </span>
        <Countdown variant="chip" mode="session" />
      </div>
    )
  }
</header>

<style>
  /* --- slim sale row (inside the sticky header) --- */
  .nav-sale {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: center;
    gap: 0.15rem 0.6rem;
    border-top: 1px solid color-mix(in srgb, var(--color-signal) 22%, transparent);
    background: color-mix(in srgb, var(--color-signal) 7%, transparent);
    padding: 0.4rem 1rem;
    text-align: center;
  }
  .nav-sale-lead {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
  }
  .nav-sale-name {
    font-size: 0.7rem;
    letter-spacing: 0.06em;
    color: var(--color-signal);
  }
  .nav-sale-claim {
    font-size: 0.78rem;
    color: var(--color-muted);
  }
  /* Decorative separator so the sale name doesn't run into the discount. Lives in
     CSS, not the DOM, so screen readers hear "…sale" then "₹5,000 off…" cleanly —
     and it disappears with the claim on expiry. */
  .nav-sale-claim::before {
    content: "· ";
    color: var(--color-muted);
  }
  .nav-sale-off {
    color: var(--color-text);
    font-weight: 600;
  }
  .nav-sale-ends {
    white-space: nowrap;
  }
  .nav-sale-next {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
  }
  .nav-sale-next-lbl {
    font-size: 0.7rem;
    letter-spacing: 0.06em;
    color: var(--color-muted);
    white-space: nowrap;
  }
  /* Honest expiry WITHOUT a sticky-header height change: the Countdown flips itself
     to "sale ended", and the now-false offer claim is dropped. The row survives, so
     nothing jumps under the reader. */
  .nav-sale:has([data-expired="true"]) .nav-sale-claim {
    display: none;
  }
  /* Phones: drop the redundant end date (the timer says the same thing, and Pricing
     states it in full), and shrink the digits so the label + all four units still
     share ONE line. Without this, seconds push the row to three lines and the sticky
     header eats a third of a 380px viewport. */
  @media (max-width: 30rem) {
    .nav-sale {
      gap: 0.1rem 0.45rem;
      padding-inline: 0.75rem;
    }
    .nav-sale-ends {
      display: none;
    }
    .nav-sale-next {
      gap: 0.3rem;
    }
    :global(.nav-sale-cd .cd-units) {
      gap: 0.15rem;
    }
    :global(.nav-sale-cd .cd-unit) {
      padding: 0.2rem 0.2rem;
    }
    :global(.nav-sale-cd .cd-num) {
      font-size: 0.75rem;
    }
    :global(.nav-sale-cd .cd-lbl) {
      font-size: 0.45rem;
    }
  }

  /* Compact the chip so "batch starts in" + d/h/m fits at 380px. */
  :global(.nav-urgency .cd-units) {
    gap: 0.2rem;
  }
  :global(.nav-urgency .cd-num) {
    font-size: 0.8rem;
  }
  :global(.nav-urgency .cd-lbl) {
    font-size: 0.5rem;
  }
</style>
