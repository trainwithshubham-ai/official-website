---
// Hero — the above-the-fold conversion core (ARCHITECTURE.md §4.2).
// Eyebrow · H1 · subhead · animated pipeline · batch date · Countdown · dual CTA.
// Depth: dual ambient glow (primary + amber) over a faint pipeline grid (BRAND.md
// §5 evolution). The animated pipeline is the one bold motion moment (§2).
import { site } from "../config/site";
import Button from "./primitives/Button.astro";
import Countdown from "./Countdown.astro";
import Eyebrow from "./primitives/Eyebrow.astro";
import PipelineAnim from "./PipelineAnim.astro";

const batchDate = new Date(site.batchStartISO).toLocaleDateString("en-IN", {
  day: "numeric",
  month: "long",
  year: "numeric",
});

// Class days/time are TODO placeholders in site.ts — only show once real.
const daysReady = !site.classDays.startsWith("TODO");
const timeReady = !site.classTime.startsWith("TODO");
const scheduleBits = [
  `Starts ${batchDate}`,
  daysReady ? site.classDays : null,
  timeReady ? site.classTime : null,
].filter(Boolean);
---

<section id="top" class="relative overflow-hidden">
  <!-- depth: dual ambient glow over a faint pipeline grid (BRAND.md §5) -->
  <div aria-hidden="true" class="pointer-events-none absolute inset-0 -z-10 overflow-hidden">
    <div
      class="absolute -top-40 left-1/2 h-[40rem] w-[40rem] -translate-x-1/2 rounded-full bg-primary/10 blur-[120px]"
    >
    </div>
    <div
      class="absolute -top-10 right-[-12rem] h-[26rem] w-[26rem] rounded-full bg-signal/[0.06] blur-[120px]"
    >
    </div>
    <div class="hero-grid absolute inset-0"></div>
  </div>

  <div
    class="mx-auto flex max-w-[var(--container-content)] flex-col items-center gap-7 px-6 pt-20 pb-16 text-center sm:pt-28 sm:pb-24"
  >
    <!-- Terminal eyebrow, typed in. Replaces the old pill: same slot, same job
         (name the product above a benefit headline), but it uses the ❯ mono prompt
         the rest of the page already uses (BRAND.md §2) instead of a badge, and the
         name comes from site.product so it can't drift out of sync again. -->
    <span class="hero-type" style={`--chars:${site.product.length + 2}`}>
      <Eyebrow text={site.product} as="span" />
    </span>

    <h1 class="max-w-4xl text-balance">
      Become an AI-powered DevOps engineer who ships to production.
    </h1>

    <p class="max-w-2xl text-pretty text-lg text-muted">
      Start from the fundamentals and go all the way to shipping real systems —
      pipelines, Kubernetes, Terraform and observability, with AI in your
      workflow. No prior experience required.
    </p>

    <PipelineAnim />

    <p class="font-mono text-sm text-primary">
      {scheduleBits.join(" · ")}
    </p>

    <Countdown variant="full" announceDeadline class="items-center" />

    <div class="mt-2 flex flex-col items-center gap-4 sm:flex-row">
      <Button href="#pricing">Enroll now</Button>
      <Button href="#curriculum" variant="ghost">See the curriculum</Button>
    </div>
  </div>
</section>

<style>
  /* --- terminal type-in for the eyebrow ---
     Reveals with clip-path, NOT width: clip-path is composited, so the eyebrow
     occupies its final box on the first frame and contributes nothing to CLS
     directly above the H1. Stepped by character count (--chars, set from
     site.product at build time) so it reads as typing rather than a wipe.
     Longhands, not the `animation` shorthand: if a browser rejects
     steps(var(--chars)) the timing function alone is dropped and the reveal still
     runs (as an ease), instead of the whole animation being invalidated.
     prefers-reduced-motion → no animation at all, just static text (tokens.css
     also kills animations globally, this is belt-and-braces). */
  .hero-type {
    display: inline-block;
  }
  /* Block caret, sized in em so it tracks the eyebrow's font. Reserved in layout
     from the start (never animates size) and clipped along with the text, so it
     only surfaces once typing finishes. */
  .hero-type::after {
    content: "";
    display: inline-block;
    width: 0.5em;
    height: 1em;
    margin-left: 0.18em;
    vertical-align: -0.12em;
    background: var(--color-primary);
    opacity: 0;
  }
  @media (prefers-reduced-motion: no-preference) {
    .hero-type {
      animation-name: hero-type;
      animation-duration: calc(var(--chars) * 22ms);
      animation-timing-function: steps(var(--chars));
      animation-fill-mode: both;
    }
    /* Blinks a few times, then settles hidden — a caret pulsing forever next to
       the headline competes with it (BRAND.md §9: motion stays restrained). */
    .hero-type::after {
      animation-name: hero-caret;
      animation-duration: 0.7s;
      animation-timing-function: step-end;
      animation-delay: calc(var(--chars) * 22ms);
      animation-iteration-count: 4;
      animation-fill-mode: both;
    }
  }
  @keyframes hero-type {
    from {
      clip-path: inset(0 100% 0 0);
    }
    to {
      clip-path: inset(0 0 0 0);
    }
  }
  @keyframes hero-caret {
    0%,
    50% {
      opacity: 1;
    }
    50.01%,
    100% {
      opacity: 0;
    }
  }

  /* faint infra grid behind the hero, faded with a radial mask (BRAND.md §5) */
  .hero-grid {
    background-image:
      linear-gradient(
        to right,
        color-mix(in srgb, var(--color-line) 55%, transparent) 1px,
        transparent 1px
      ),
      linear-gradient(
        to bottom,
        color-mix(in srgb, var(--color-line) 55%, transparent) 1px,
        transparent 1px
      );
    background-size: 48px 48px;
    -webkit-mask-image: radial-gradient(
      ellipse 70% 60% at 50% 0%,
      black,
      transparent 75%
    );
    mask-image: radial-gradient(
      ellipse 70% 60% at 50% 0%,
      black,
      transparent 75%
    );
  }
</style>
