---
// Pricing — the conversion core (ARCHITECTURE.md §4.10).
// Transparent dual pricing (India / US, no IP geo-switch — golden rule 6), a
// "batch starts in" Countdown, inclusions, and the Enroll CTA. Renders `activePrice`
// (site.ts) — the standing price normally, the sale price while site.sale is live —
// so the amount shown and the amount the button charges can never drift apart.
import { site, saleLive, activePrice } from "../config/site";
import Section from "./primitives/Section.astro";
import Countdown from "./Countdown.astro";
import EnrollButtons from "./EnrollButtons.astro";
import BonusBar from "./BonusBar.astro";
import StatusDot from "./primitives/StatusDot.astro";
import { inclusions } from "../content/data";

const refundReady = !site.refundPolicy.startsWith("TODO");

// Screen-reader price breakdown — built as a string so Astro's whitespace trimming
// around {expressions} can't drop spaces between price + currency.
// The purchase point states the deadline in full — the header's slim row only has
// room for "ends 15 Aug", and a ticking timer alone never spells the date out.
const saleEndsFull = new Date(site.sale.endsISO).toLocaleString("en-IN", {
  day: "numeric",
  month: "long",
  year: "numeric",
  hour: "2-digit",
  minute: "2-digit",
  hour12: false,
  timeZone: "Asia/Kolkata",
});

// The sale price is unlocked by a coupon at checkout, so the SR breakdown has to
// carry the code too — a blind visitor must not reach Learnyst, see the standing
// price and have no idea why.
const coupon = saleLive ? site.sale.coupon : null;
const saleSr = saleLive
  ? `${site.sale.name} — ${site.sale.off.india} in India, ${site.sale.off.world} elsewhere${coupon ? `, with coupon ${coupon} applied at checkout` : ""}. `
  : "";
const priceSr = `${saleSr}Price: ${activePrice.india.now} for India (originally ${activePrice.india.list}), ${activePrice.world.now} for the rest of the world (originally ${activePrice.world.list}). Choose your region to pay.`;
---

<Section id="pricing" eyebrow="pricing" title="Enrol now — secure your seat">
  <div
    class="pricing-card surface-card grad-border mx-auto w-full max-w-xl rounded-[var(--radius-card)] p-8 text-center sm:p-10"
  >
    {/* Sale chip — amber (urgency), never yellow (golden rule 5). The visible timer
        below now counts to the next class, so the sale states its deadline in words.
        The invisible marker keeps the honest-expiry behaviour: when the sale really
        ends it flips [data-expired] and the CSS drops these now-false lines. */}
    {
      saleLive && (
        <div class="sale-chip">
          <Countdown variant="marker" deadline={site.sale.endsISO} />
          <p class="sale-chip-row">
            <StatusDot tone="signal" />
            <span class="sale-chip-name">{site.sale.name}</span>
            <span class="sale-chip-off">
              {site.sale.off.india} · {site.sale.off.world}
            </span>
          </p>
          <p class="sale-chip-ends">Ends {saleEndsFull} IST</p>
        </div>
      )
    }

    <p
      class="font-mono text-[length:var(--text-eyebrow)] lowercase tracking-[0.08em] text-primary"
    >
      ❯ your price
    </p>
    <!-- Region-priced: the visitor's likely currency (browser timezone, never
         IP — flag set pre-paint on <html>) is the big anchor; the other stays
         visible but smaller. Both always shown — emphasis, never a hide/swap
         (golden rule 6). India is the default anchor when region is unknown. -->
    <div aria-hidden="true">
      <div
        class="mt-3 flex flex-wrap items-baseline justify-center gap-x-2 gap-y-1"
      >
        <span class="text-lg text-muted">from</span>
        <span class="price-amt amt-india">{activePrice.india.now}</span>
        <span class="price-sep">·</span>
        <span class="price-amt amt-world">{activePrice.world.now}</span>
      </div>
      <p class="mt-2 text-sm text-muted">
        {saleLive ? "was" : "originally"} <s>{activePrice.india.list}</s>
        <span> / </span>
        <s>{activePrice.world.list}</s>
      </p>
    </div>
    <p class="sr-only">{priceSr}</p>

    <div class="mt-6 flex justify-center">
      <Countdown variant="full" class="items-center" />
    </div>

    <!-- inclusions -->
    <!-- list block is centered (mx-auto w-fit) for box symmetry, but items stay
         left-aligned so the checkmarks form a clean column -->
    <ul class="mx-auto mt-8 flex w-fit flex-col gap-3 text-left">
      {
        inclusions.map((item) => (
          <li class="flex items-start gap-3">
            <svg
              class="mt-0.5 size-5 shrink-0 text-primary"
              viewBox="0 0 20 20"
              fill="none"
              aria-hidden="true"
            >
              <path
                d="M4 10.5l3.5 3.5L16 6"
                stroke="currentColor"
                stroke-width="2"
                stroke-linecap="round"
                stroke-linejoin="round"
              />
            </svg>
            <span class="text-text">{item}</span>
          </li>
        ))
      }
    </ul>

    <!-- daily bonus (real, repeatable; honest end-of-day IST timer) -->
    <BonusBar class="mt-8" />

    <!-- CTA — one button per region (transparent, learner picks; golden rule 6).
         `note` shows the welcoming geo-pricing helper here (the main conversion
         point); FinalCTA reuses the buttons without it. -->
    {/* Coupon hint — sits immediately above the pay buttons, the last thing read
        before leaving for Learnyst. It has to be here: checkout shows the standing
        price until the code is entered, so without this the page and the checkout
        would disagree. Selectable text, no copy button (JS budget = the countdown). */}
    {
      coupon && (
        <p class="coupon-hint">
          Apply coupon <code class="coupon-code">{coupon}</code>{" "}
          <span class="coupon-where">at checkout</span>
        </p>
      )
    }

    <EnrollButtons
      class="mt-3"
      note
      priceQualifier={saleLive ? `${site.sale.name} price` : ""}
    />

    {
      refundReady && (
        <p class="mt-4 text-center text-sm text-muted">{site.refundPolicy}</p>
      )
    }
  </div>
</Section>

<style>
  /* Sale chip — amber urgency band above the price. Sits on surface-2 with a
     signal-tinted hairline so it reads as a temporary state, not a permanent part
     of the card. It disappears with the sale (the whole block is gated on
     saleLive), and its Countdown flips to "sale ended" the moment the real
     deadline passes — no reset, no fake urgency (golden rule 6). */
  .sale-chip {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 0.3rem;
    margin-bottom: 1.25rem;
    padding: 0.55rem 0.9rem;
    border: 1px solid color-mix(in srgb, var(--color-signal) 35%, transparent);
    /* Rounded rect, NOT --radius-pill: the row wraps to two lines at 380px and a
       999px radius turns the block into a balloon. */
    border-radius: 12px;
    background: color-mix(in srgb, var(--color-signal) 8%, transparent);
    font-size: 0.8rem;
  }
  .sale-chip-row {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: center;
    gap: 0.15rem 0.5rem;
  }
  .sale-chip-name {
    font-weight: 600;
    color: var(--color-signal);
  }
  .sale-chip-off {
    color: var(--color-muted);
  }
  .sale-chip-ends {
    font-size: 0.72rem;
    color: var(--color-muted);
  }

  /* Coupon hint. Amber --signal ties it to the sale; deliberately NOT yellow, which
     belongs to the Enroll button sitting right beneath it (golden rule 5) — two
     yellow things stacked would fight for the same click. */
  .coupon-hint {
    margin-top: 1.5rem;
    font-size: 0.875rem;
    color: var(--color-muted);
  }
  .coupon-code {
    display: inline-block;
    margin-inline: 0.15rem;
    padding: 0.15rem 0.5rem;
    border: 1px dashed color-mix(in srgb, var(--color-signal) 55%, transparent);
    border-radius: 6px;
    background: color-mix(in srgb, var(--color-signal) 10%, transparent);
    font-family: var(--font-mono);
    font-size: 0.9em;
    font-weight: 600;
    letter-spacing: 0.08em;
    color: var(--color-signal);
    /* the code is meant to be selected and pasted into Learnyst */
    user-select: all;
  }
  /* Keep "at checkout" together so it breaks after the code rather than orphaning
     "checkout" onto a line of its own at 380px. */
  .coupon-where {
    white-space: nowrap;
  }
  /* When the sale really ends, the hidden marker flips [data-expired] and the whole
     chip goes — it would otherwise keep advertising a discount and a deadline that
     have both passed. Safe to remove entirely (unlike the sticky header row): this
     card scrolls normally, so nothing jumps under the reader. */
  .sale-chip:has([data-expired="true"]) {
    display: none;
  }

  /* Region-priced headline: the detected region's amount (html[data-region-guess],
     set pre-paint in BaseLayout — timezone, never IP) is the big anchor; the other
     stays visible but smaller. Emphasis only — both always shown (golden rule 6).
     India is the default anchor when the region is unknown (attr unset). Because
     the flag is set before first paint, there's no ₹→$ flip/flash on load. */
  .price-amt {
    font-family: var(--font-display);
    line-height: 1.1;
  }
  /* ANCHOR (big) — the visitor's OWN currency: India by default, the world price
     when the region flag flips. Defined once, applied to whichever span is the
     anchor. (The html[...] selector outspecifies the base, so on a world visitor
     .amt-world wins the anchor and .amt-india falls to ALT below.) */
  .amt-india,
  :global(html[data-region-guess="world"]) .amt-world {
    font-size: clamp(2rem, 9vw, 2.5rem);
    font-weight: 700;
    color: var(--color-text);
  }
  /* ALT (small) — the other currency, kept fully visible but secondary. */
  .amt-world,
  :global(html[data-region-guess="world"]) .amt-india {
    font-size: 1.5rem;
    font-weight: 600;
    color: var(--color-muted);
  }
  .price-sep {
    font-family: var(--font-display);
    font-size: 1.5rem;
    font-weight: 300;
    color: var(--color-muted);
  }
</style>
